<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report Title"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etTherapistReportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter report title"
            android:singleLine="true"
            android:maxLength="200"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report Content"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etTherapistReportContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Describe the child's therapy progress, observations, achievements and areas for improvement"
            android:gravity="top|start"
            android:minLines="6"
            android:maxLines="12"
            android:maxLength="5000"
            android:inputType="textCapSentences|textMultiLine" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The report will be saved as a draft first."
            android:textSize="12sp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
