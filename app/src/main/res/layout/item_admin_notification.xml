<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvAdminNotificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Session Reminder"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdminNotificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Notification message"
            android:textColor="#555555"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAdminNotificationType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Type: Session"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAdminNotificationRecipient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="To: Parent"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAdminNotificationBranch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Branch: Patna"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAdminNotificationDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Date: 21 Sep 2026"
            android:textColor="#666666"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvAdminNotificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: Sent"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>