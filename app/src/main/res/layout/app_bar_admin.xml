<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Admin Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false">

        <!-- Admin Toolbar with Notification Bell -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/adminTopAppBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/parent_navy"
                android:elevation="4dp"
                android:translationY="12dp"
                app:title="Rehablito Autism Center"
                app:titleTextColor="@android:color/white"
                app:navigationIconTint="@android:color/white" />

            <!-- Notification Bell -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:background="@color/parent_navy"
                android:translationY="12dp">

                <ImageButton
                    android:id="@+id/adminBtnNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_notifications"
                    android:scaleType="center"
                    android:padding="14dp"
                    android:contentDescription="Notifications"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/adminTvUnreadNotificationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="18dp"
                    android:minHeight="18dp"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_notification_badge"
                    android:visibility="gone"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="5dp" />

            </FrameLayout>

        </LinearLayout>
        <!-- Admin Page Content -->
        <FrameLayout
            android:id="@+id/adminContentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/white" />

        <!-- Admin Bottom Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/adminBottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/parent_card_background"
            app:navigationIconTint="@color/parent_navy"
            app:menu="@menu/admin_bottom_navigation_menu" />

    </LinearLayout>

    <!-- Admin Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/adminNavigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white"
        app:headerLayout="@layout/admin_navigation_header"
        app:menu="@menu/admin_navigation_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
