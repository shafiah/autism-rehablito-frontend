<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/parent_card_background"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="#E2E2E8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAdminSessionChild"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ayaan Singh"
                    android:textColor="#222222"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAdminSessionTherapist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Therapist: Dr. Neha Sharma"
                    android:textColor="#666666"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvAdminSessionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8F5E9"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="Scheduled"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Divider -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#EEEEEE" />


        <!-- Therapy -->

        <TextView
            android:id="@+id/tvAdminSessionTherapy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Occupational Therapy"
            android:textColor="@color/parent_navy"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Branch -->

        <TextView
            android:id="@+id/tvAdminSessionBranch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Branch: Patna"
            android:textColor="#555555"
            android:textSize="13sp" />

        <!-- Date Time -->

        <TextView
            android:id="@+id/tvAdminSessionDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="21 Sep 2026  •  09:00 AM"
            android:textColor="#555555"
            android:textSize="13sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>